# ==============================================================================
# ManiMart Environment Configuration Example
# Copy this file to .env and configure appropriate values for your environment.
# ==============================================================================

# Server Configuration
SERVER_HOST=0.0.0.0
SERVER_PORT=8080
SERVER_THREADS=4
SESSION_TIMEOUT_SECONDS=3600
LOG_LEVEL=info

# Database Configuration (PostgreSQL for production, SQLite for local/testing)
DB_TYPE=sqlite
# DB_TYPE=postgres

# PostgreSQL Connection Settings
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=manimart_db
DB_USER=manimart_user
DB_PASSWORD=manimart_password
DATABASE_URL=postgresql://manimart_user:manimart_password@127.0.0.1:5432/manimart_db

# SQLite Connection Settings (Used if DB_TYPE=sqlite)
SQLITE_DB_PATH=manimart.db

# AI Chatbot Configuration
# Supported providers: "mock" (offline canned responses) or "gemini" (Google Gemini API)
AI_PROVIDER=mock
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash
CHAT_TIMEOUT_MS=5000
CHAT_RATE_LIMIT_PER_MINUTE=10

# Security Settings
ADMIN_DEFAULT_PASSWORD=AdminPass@123
TOKEN_SECRET=manimart_super_secret_signing_key_32_bytes_long!
